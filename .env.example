# Stripe API Keys
# Get these from https://dashboard.stripe.com/test/apikeys
# Use sk_test_/pk_test_ for sandbox, sk_live_/pk_live_ for production
STRIPE_SECRET_KEY=sk_test_your_test_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_test_publishable_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_test_publishable_key_here

# Stripe Webhook Secret (for webhooks)
# Get this from https://dashboard.stripe.com/test/webhooks
# For local dev, use: stripe listen --forward-to localhost:3000/api/stripe-webhook
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Site URL
# Use http://localhost:3000 for local development
# Use https://yourdomain.com for production
SITE_URL=http://localhost:3000

# Loops contact sync. Paid subscriptions are assigned to the `Core User`
# userGroup, which starts the existing purchase sequence.
LOOPS_API_KEY=

# Whop checkout and subscription sync
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
WHOP_ACCOUNT_ID=biz_tGIL6R2J3Z0k5p
WHOP_PRODUCT_ID=prod_gOqq98A2Us54W
WHOP_PUBLIC_FORUM_EXPERIENCE_ID=exp_tnWXo8jYEONzgK
WHOP_GENERAL_CHAT_CHANNEL_ID=chat_feed_1CeHaJJyu9zGB32AV5oDSj
WHOP_LOCAL_CHAT_CHANNEL_ID=chat_feed_1CeHdRxgaX1ergR511Vmgn
WHOP_OAUTH_CLIENT_ID=app_
WHOP_OAUTH_CLIENT_SECRET=
WHOP_OAUTH_REDIRECT_URI=http://localhost:3000/checkout/complete
